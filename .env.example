# PWM Environment Variables Template
# Copy to .env and fill in values. Never commit .env.

# ── LLM API Keys (only needed if using commercial provider) ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── LLM Provider Selection ───────────────────────────────────────────────────
# Options: nemotron-local | claude-api | openai-api | gemini-api | custom
LLM_PROVIDER=nemotron-local

# ── Local inference endpoints (auto-started by pwm-serve) ────────────────────
LLM_PRIMARY_API_BASE=http://localhost:8000/v1
LLM_FAST_API_BASE=http://localhost:8001/v1
LLM_PRIMARY_API_KEY=local
LLM_FAST_API_KEY=local

# ── Custom provider (LiteLLM any model) ──────────────────────────────────────
LLM_PRIMARY_MODEL=
LLM_FAST_MODEL=

# ── Experiment tracking ───────────────────────────────────────────────────────
WANDB_PROJECT=pratyabhijna-world-model
WANDB_ENTITY=sharathsphd
# WANDB_API_KEY=  # set separately if needed
MLFLOW_TRACKING_URI=file:./mlruns

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_HOME=/home/sharaths/models
# HUGGING_FACE_HUB_TOKEN=  # set if downloading gated models

# ── Data paths ────────────────────────────────────────────────────────────────
CORPUS_ROOT=/home/sharaths/projects/PWM/data/corpus
BENCHMARK_ROOT=/home/sharaths/projects/PWM/data/benchmark
MODEL_CACHE=/home/sharaths/models
